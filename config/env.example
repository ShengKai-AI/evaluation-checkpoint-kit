# 复制为项目根目录 .env（勿提交）

# 拆考点 API（按你使用的提供商改名）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
BREAKDOWN_MODEL=gpt-4o-mini

# 并发与批处理
BREAKDOWN_BATCH_SIZE=10
BREAKDOWN_MAX_WORKERS=8

# 路径（一般无需改）
DATA_DIR=data
OUTPUT_BREAKDOWN_DIR=outputs/breakdown
OUTPUT_REPORTS_DIR=outputs/reports

# 任务描述（会注入 breakdown prompt）
TASK_DESCRIPTION=请根据样本归纳可复用的评测考点。
